<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <style>
        body {
            font-family: Arial;
            padding: 40px;
            background: #f5f5f5;
        }

        h1 {
            margin-bottom: 20px;
        }

        .top-bar {
            margin-bottom: 20px;
        }

        .add-btn {
            background: black;
            color: white;
            padding: 10px 18px;
            text-decoration: none;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }

        th {
            background: black;
            color: white;
        }

        img {
            width: 70px;
            height: 70px;
            object-fit: cover;
        }

        .edit-btn {
            background: #3498db;
            color: white;
            padding: 8px 12px;
            text-decoration: none;
        }

        .delete-btn {
            background: #e74c3c;
            color: white;
            padding: 8px 12px;
            border: none;
            cursor: pointer;
        }
    </style>

</head>

<body>

    <h1>Admin Dashboard</h1>
    <p>
        <a href="/">Home</a> |
        <a href="/products">View Products Page</a> |
        <a href="/admin/products/add">Add Product</a>
    </p>

    <div class="top-bar">
        <a href="/admin/products/add" class="add-btn">
            Add New Product
        </a>
    </div>

    <table>

        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Stock</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>

        <% products.forEach(product=> { %>

            <tr>

                <td>
                    <img src="<%= product.image %>">
                </td>

                <td>
                    <%= product.name %>
                </td>

                <td>PKR <%= product.price %>
                </td>

                <td>
                    <%= product.category %>
                </td>

                <td>
                    <%= product.stock %>
                </td>

                <td>
                    <a href="/admin/products/edit/<%= product._id %>" class="edit-btn">
                        Edit
                    </a>
                </td>

                <td>

                    <form action="/admin/products/delete/<%= product._id %>" method="POST">

                        <button type="submit" class="delete-btn"
                            onclick="return confirm('Are you sure you want to delete this product?')">

                            Delete

                        </button>

                    </form>

                </td>

            </tr>

            <% }) %>

    </table>

</body>

</html>