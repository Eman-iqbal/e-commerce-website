<section style="padding:40px; font-family:Arial; background:#f5f5f5; min-height:100vh;">

  <h1>Real-Time Sales Dashboard</h1>
  <p>This dashboard updates automatically every 10 seconds.</p>

  <div style="display:flex; gap:20px; margin-top:30px; flex-wrap:wrap;">

    <div style="background:white; padding:25px; width:250px; box-shadow:0 2px 8px #ccc;">
      <h3>Total Revenue</h3>
      <h2>PKR <span id="totalRevenue"><%= stats.totalRevenue %></span></h2>
    </div>

    <div style="background:white; padding:25px; width:250px; box-shadow:0 2px 8px #ccc;">
      <h3>Total Orders</h3>
      <h2 id="totalOrders"><%= stats.totalOrders %></h2>
    </div>

    <div style="background:white; padding:25px; width:250px; box-shadow:0 2px 8px #ccc;">
      <h3>Top-Selling Product</h3>
      <h2 id="topProduct"><%= stats.topProduct %></h2>
    </div>

  </div>

  <h2 style="margin-top:40px;">Recent Transactions</h2>

  <table style="width:100%; background:white; border-collapse:collapse; margin-top:20px;">
    <thead>
      <tr style="background:black; color:white;">
        <th style="padding:12px;">Product</th>
        <th style="padding:12px;">Customer</th>
        <th style="padding:12px;">Quantity</th>
        <th style="padding:12px;">Amount</th>
      </tr>
    </thead>

    <tbody id="transactionsTable">
      <% stats.recentTransactions.forEach(sale => { %>
        <tr>
          <td style="padding:12px; border:1px solid #ddd;"><%= sale.productName %></td>
          <td style="padding:12px; border:1px solid #ddd;"><%= sale.customerName %></td>
          <td style="padding:12px; border:1px solid #ddd;"><%= sale.quantity %></td>
          <td style="padding:12px; border:1px solid #ddd;">PKR <%= sale.totalAmount %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</section>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
  function loadSalesData() {
    $.getJSON('/api/sales-data', function(data) {

      $('#totalRevenue').text(data.totalRevenue);
      $('#totalOrders').text(data.totalOrders);
      $('#topProduct').text(data.topProduct);

      let rows = '';

      data.recentTransactions.forEach(function(sale) {
        rows += `
          <tr>
            <td style="padding:12px; border:1px solid #ddd;">${sale.productName}</td>
            <td style="padding:12px; border:1px solid #ddd;">${sale.customerName}</td>
            <td style="padding:12px; border:1px solid #ddd;">${sale.quantity}</td>
            <td style="padding:12px; border:1px solid #ddd;">PKR ${sale.totalAmount}</td>
          </tr>
        `;
      });

      $('#transactionsTable').html(rows);
    });
  }

  $(document).ready(function() {
    setInterval(loadSalesData, 10000);
  });
</script>