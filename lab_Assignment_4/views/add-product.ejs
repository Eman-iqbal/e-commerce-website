<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= title %></title>

  <style>

    body{
      font-family:Arial;
      background:#f5f5f5;
      padding:40px;
    }

    form{
      background:white;
      max-width:500px;
      padding:30px;
    }

    input{
      width:100%;
      padding:10px;
      margin-bottom:15px;
    }

    button{
      background:black;
      color:white;
      padding:12px 20px;
      border:none;
      cursor:pointer;
    }

  </style>

</head>
<body>

  <h1>Add Product</h1>
  <a href="/admin">Back to Dashboard</a>

  <form
    action="/admin/products/add"
    method="POST"
    enctype="multipart/form-data">

    <input
      type="text"
      name="name"
      placeholder="Product Name" required>

    <input
      type="number"
      name="price"
      placeholder="Price" required>

    <input
      type="text"
      name="category"
      placeholder="Category" required>

    <input
      type="number"
      step="0.1"
      name="rating"
      placeholder="Rating" required>

    <input
      type="number"
      name="stock"
      placeholder="Stock" required>

    <input
      type="file"
      name="image">

    <button type="submit">
      Add Product
    </button>

  </form>

</body>
</html>